# Application
ENVIRONMENT=development
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8010
API_WORKERS=1
API_RELOAD=false
CORS_ORIGINS=https://sentinelops.example.com

# Security / SentinelOps integration
DATABASE_URL=postgresql://user:password@host:5432/sentinelops
SECRET_KEY=replace-with-the-same-jwt-secret-used-by-sentinelops
ALGORITHM=HS256
ADMIN_API_TOKEN=replace-with-admin-token
NEXUS_AGENT_API_TOKEN=replace-with-agent-token

# Nexus state
NEXUS_REQUIRE_DATABASE=true
NEXUS_ALLOW_LOCAL_STATE=false
NEXUS_WRITE_ROLES=admin,manager,supervisor
NEXUS_ADMIN_ROLES=admin
NEXUS_ALLOWED_SECTION_IDS=section-uuid
NEXUS_REQUIRE_AGENT_AUTH=true

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=alerts@example.com
SMTP_USE_TLS=false
SMTP_STARTTLS=true

# Mistral API
MISTRAL_API_KEY=replace-with-mistral-api-key
MISTRAL_API_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-small-latest
MISTRAL_CLASSIFICATION_MODEL=
MISTRAL_MODERATION_MODEL=mistral-moderation-latest
MISTRAL_TEMPERATURE=0.1
MISTRAL_MAX_TOKENS=900
MISTRAL_TIMEOUT_SECONDS=25
MISTRAL_MAX_RETRIES=2
MISTRAL_CIRCUIT_BREAKER_THRESHOLD=3
ENABLE_CLASSIFIER_ENDPOINTS=true
ENABLE_MODERATION_GUARDRAILS=false

# Embeddings / Vector store
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BACKEND=auto
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKING=true
VECTOR_STORE_TYPE=local
QDRANT_URL=
QDRANT_API_KEY=
REDIS_URL=
