# Application
ENVIRONMENT=development
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8010
API_WORKERS=1
API_RELOAD=false
CORS_ORIGINS=https://sentinelops.example.com

# Security / SentinelOps integration
DATABASE_URL=postgresql://user:password@host:5432/sentinelops
SECRET_KEY=replace-with-the-same-jwt-secret-used-by-sentinelops
ALGORITHM=HS256
ADMIN_API_TOKEN=replace-with-admin-token
NEXUS_AGENT_API_TOKEN=replace-with-agent-token

# Nexus state
NEXUS_REQUIRE_DATABASE=true
NEXUS_ALLOW_LOCAL_STATE=false
NEXUS_WRITE_ROLES=admin,manager,supervisor
NEXUS_ADMIN_ROLES=admin
NEXUS_CLEARING_MAKER_ROLES=admin,manager,supervisor
NEXUS_CLEARING_APPROVER_ROLES=admin,manager
NEXUS_CLEARING_EXECUTOR_ROLES=admin,manager
NEXUS_CLEARING_ROLLBACK_ROLES=admin
NEXUS_ALLOWED_SECTION_IDS=section-uuid
NEXUS_REQUIRE_AGENT_AUTH=true

# Nexus unauthorized-transaction clearing
# Keep read and write identities separate. The write identity should have only
# the tested ACNTBAL update and ASIBGPQNP delete/insert grants it requires.
NEXUS_CLEARING_ORACLE_RO_DSN=
NEXUS_CLEARING_ORACLE_RO_USER=
NEXUS_CLEARING_ORACLE_RO_PASSWORD=
NEXUS_CLEARING_ORACLE_RW_DSN=
NEXUS_CLEARING_ORACLE_RW_USER=
NEXUS_CLEARING_ORACLE_RW_PASSWORD=
NEXUS_CLEARING_ORACLE_CONFIG_DIR=
NEXUS_CLEARING_ENTITY_NUMBER=1
NEXUS_CLEARING_TIMEZONE=Africa/Harare
NEXUS_CLEARING_MAX_BATCH_SIZE=500
NEXUS_CLEARING_MAX_SOURCE_BYTES=8388608

# The primary gate enables writes outside production. Production requires both
# gates. Keep the production gate false until the UAT evidence pack is approved.
NEXUS_CLEARING_WRITES_ENABLED=false
NEXUS_CLEARING_PRODUCTION_WRITES_ENABLED=false

# Nexus CRB reporting (read-only LMS Oracle identity)
# Use LMS_ORACLE_DSN for a TNS alias/easy-connect string, or provide host plus
# either SID or service name. Exports are atomically replaced and purged daily.
LMS_ORACLE_DSN=
LMS_ORACLE_USER=
LMS_ORACLE_PASSWORD=
LMS_ORACLE_HOST=
LMS_ORACLE_PORT=1521
LMS_ORACLE_SID=
LMS_ORACLE_SERVICE_NAME=
LMS_ORACLE_CONFIG_DIR=
NEXUS_CRB_TIMEZONE=Africa/Harare
NEXUS_CRB_SCHEDULE_TIME=07:15
NEXUS_CRB_FETCH_SIZE=5000
# Optional absolute path. Defaults to <Nexus>/data/reports/crb.
# NEXUS_CRB_REPORT_DIR=/srv/Sentinel/Nexus/data/reports/crb

# Reporting Custody: txn-bot loan hovering queue
# This identity reads hovering and setting. It requires UPDATE on
# hovering.installment_date plus setting.value and setting.updated.
TXN_BOT_DATABASE_URL=postgresql://sentinel_hovering:password@host:5432/txn-bot
NEXUS_HOVERING_CREDIT_ACCOUNT=310004003
NEXUS_HOVERING_TYPE=LOAN_LEDGER_FEES
NEXUS_HOVERING_TIMEZONE=Africa/Harare
NEXUS_HOVERING_BOT_WINDOW_START=03:00
NEXUS_HOVERING_BOT_WINDOW_END=15:00
NEXUS_HOVERING_WEEKEND_WINDOW_END=09:00
NEXUS_HOVERING_SAMPLE_INTERVAL_SECONDS=15
NEXUS_HOVERING_RATE_WINDOW_MINUTES=60
NEXUS_HOVERING_STALL_MINUTES=15
NEXUS_HOVERING_MAX_PAGE_SIZE=100
NEXUS_HOVERING_ENCRYPTION_URL=http://192.168.0.71:8099/internal/encryption/encrypt
NEXUS_HOVERING_ENCRYPTION_TIMEOUT_SECONDS=10
NEXUS_HOVERING_PASSWORD_ROLES=admin,manager,user

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=alerts@example.com
SMTP_USE_TLS=false
SMTP_STARTTLS=true

# Mistral API
MISTRAL_API_KEY=replace-with-mistral-api-key
MISTRAL_API_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-small-latest
MISTRAL_CLASSIFICATION_MODEL=
MISTRAL_MODERATION_MODEL=mistral-moderation-latest
MISTRAL_TEMPERATURE=0.1
MISTRAL_MAX_TOKENS=900
MISTRAL_TIMEOUT_SECONDS=25
MISTRAL_MAX_RETRIES=2
MISTRAL_CIRCUIT_BREAKER_THRESHOLD=3
ENABLE_CLASSIFIER_ENDPOINTS=true
ENABLE_MODERATION_GUARDRAILS=false

# Embeddings / Vector store
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BACKEND=auto
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKING=true
VECTOR_STORE_TYPE=local
QDRANT_URL=
QDRANT_API_KEY=
REDIS_URL=
